# OPCIONAL: em produção o app já usa o projeto Supabase da equipe (src/lib/supabase.js).
# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel
# (Project > Settings > Environment Variables). Valores em: Supabase > Project Settings > API Keys / Data API.

# URL do projeto Supabase (somente o endereço, sem /rest/v1)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave PÚBLICA: "Publishable key" (sb_publishable_...) ou a antiga "anon public" (eyJ...)
# Nunca use a "Secret key" / "service_role" aqui — ela iria para o navegador.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
